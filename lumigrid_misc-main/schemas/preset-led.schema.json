{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LED Effect Preset",
  "description": "Schema for LED effect presets including RGBW color values",
  "type": "object",
  "required": ["preset_id", "name", "color"],
  "properties": {
    "preset_id": {
      "type": "integer",
      "description": "Unique identifier for the preset",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the preset",
      "minLength": 1,
      "maxLength": 50
    },
    "color": {
      "type": "object",
      "description": "RGBW color values",
      "required": ["r", "g", "b", "w"],
      "properties": {
        "r": {
          "type": "integer",
          "description": "Red channel value",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "description": "Green channel value",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "description": "Blue channel value",
          "minimum": 0,
          "maximum": 255
        },
        "w": {
          "type": "integer",
          "description": "White channel value",
          "minimum": 0,
          "maximum": 255
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "string",
      "description": "Optional effect type",
      "enum": ["static", "fade", "pulse", "strobe", "rainbow"]
    },
    "duration_ms": {
      "type": "integer",
      "description": "Effect duration in milliseconds",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
