{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LED Node Preset",
  "description": "Schema for LumiGrid LED Node presets",
  "type": "object",
  "required": ["preset_name", "effect_id"],
  "properties": {
    "preset_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique preset identifier"
    },
    "description": {
      "type": "string",
      "maxLength": 256,
      "description": "Optional preset description"
    },
    "effect_id": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999,
      "description": "Effect identifier"
    },
    "speed": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0,
      "description": "Effect speed"
    },
    "intensity": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Effect intensity"
    },
    "brightness": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Global brightness"
    },
    "palette_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "Palette identifier"
    },
    "color1": {
      "type": "array",
      "description": "Primary RGB color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "color2": {
      "type": "array",
      "description": "Secondary RGB color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "color3": {
      "type": "array",
      "description": "Tertiary RGB color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
