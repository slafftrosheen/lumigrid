{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Display Node Preset",
  "description": "Schema for LumiGrid Display Node presets",
  "type": "object",
  "properties": {
    "preset_name": {
      "type": "string",
      "description": "Unique identifier for the preset",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "description": "Human-readable description"
    },
    "frame_config": {
      "type": "object",
      "description": "Configuration for the display frame",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "time", "date", "datetime", "temperature", "humidity", "text", "message",
            "data_visualization", "interactive", "template", "conditional",
            "multi_page", "scrolling", "animated"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "format": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "properties": {
            "background": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
            "text": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
            "accent": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" }
          }
        },
        "font": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer", "minimum": 6, "maximum": 72 }
          }
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "oneOf": [
                { "type": "integer", "minimum": -1000, "maximum": 1000 },
                { "type": "string", "enum": ["center", "left", "right"] }
              ]
            },
            "y": {
              "oneOf": [
                { "type": "integer", "minimum": -1000, "maximum": 1000 },
                { "type": "string", "enum": ["center", "top", "bottom"] }
              ]
            }
          }
        },
        "unit": {
          "type": "string",
          "enum": ["celsius", "fahrenheit"]
        }
      }
    }
  },
  "oneOf": [
    { "required": ["preset_name", "frame_config"] },
    { "required": ["type"] }
  ]
}
