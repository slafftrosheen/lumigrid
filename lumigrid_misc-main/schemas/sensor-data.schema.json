{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sensor Data Payload",
  "description": "Schema for sensor update payload from nodes",
  "type": "object",
  "required": ["node_id", "readings"],
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique identifier for the node",
      "minLength": 1
    },
    "node_name": {
      "type": "string",
      "description": "Human-readable name for the node"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in seconds",
      "minimum": 0
    },
    "readings": {
      "type": "object",
      "description": "Sensor reading values",
      "properties": {
        "temperature_c": {
          "type": "number",
          "description": "Temperature in degrees Celsius"
        },
        "humidity_percent": {
          "type": "number",
          "description": "Relative humidity percentage",
          "minimum": 0,
          "maximum": 100
        },
        "pressure_hpa": {
          "type": "number",
          "description": "Atmospheric pressure in hectopascals",
          "minimum": 0
        },
        "light_lux": {
          "type": "number",
          "description": "Light intensity in lux",
          "minimum": 0
        },
        "motion_detected": {
          "type": "boolean",
          "description": "Whether motion was detected"
        }
      }
    }
  },
  "additionalProperties": false
}
