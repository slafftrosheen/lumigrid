{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LumiGrid Trigger Schema",
  "description": "Schema for triggering actions on a LumiGrid node",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["play_preset", "set_mode", "set_brightness", "show_message"]
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "value": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    }
  },
  "required": ["action"]
}
