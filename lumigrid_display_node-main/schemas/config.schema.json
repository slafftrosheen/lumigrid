{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LumiGrid Node Configuration Schema",
  "description": "Schema for LumiGrid node configuration",
  "type": "object",
  "properties": {
    "control_mode": {
      "type": "string",
      "enum": ["Sync", "Independent"]
    },
    "sync_role": {
      "type": "string",
      "enum": ["Master", "Slave"]
    },
    "node_id": {
      "type": "string"
    },
    "network": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string"
        },
        "mdns_enabled": {
          "type": "boolean"
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "preset-display.schema.json"
      }
    }
  }
}
