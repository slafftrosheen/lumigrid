{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/algorhythmicdev/lumigrid_misc/blob/main/schemas/preset-display.schema.json",
  "title": "LumiGrid Display Preset Schema",
  "description": "Schema for LumiGrid display preset configuration including frame types and display settings",
  "type": "object",
  "properties": {
    "preset_name": {
      "type": "string",
      "description": "Unique identifier for the preset",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the preset",
      "maxLength": 500
    },
    "frame_config": {
      "type": "object",
      "description": "Frame configuration defining the display content",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of frame to display",
          "enum": [
            "time",
            "date",
            "datetime",
            "temperature",
            "humidity",
            "text",
            "message",
            "data_visualization",
            "interactive",
            "template",
            "conditional",
            "multi_page",
            "scrolling",
            "animated"
          ]
        },
        "name": {
          "type": "string",
          "description": "Display name for the frame",
          "maxLength": 100
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the frame is active",
          "default": true
        },
        "duration": {
          "type": "integer",
          "description": "Duration to display frame in seconds",
          "minimum": 1,
          "maximum": 3600
        },
        "text": {
          "type": "string",
          "description": "Text content to display",
          "maxLength": 1000
        },
        "colors": {
          "type": "object",
          "description": "Color configuration for the frame",
          "properties": {
            "background": {
              "type": "string",
              "description": "Background color in hex format",
              "pattern": "^#?([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$"
            },
            "text": {
              "type": "string",
              "description": "Text color in hex format",
              "pattern": "^#?([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$"
            },
            "accent": {
              "type": "string",
              "description": "Accent color in hex format (e.g., for colon in time display)",
              "pattern": "^#?([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$"
            }
          },
          "additionalProperties": false
        },
        "font": {
          "type": "object",
          "description": "Font configuration",
          "properties": {
            "path": {
              "type": "string",
              "description": "Font file path or name"
            },
            "size": {
              "type": "integer",
              "description": "Font size in points",
              "minimum": 6,
              "maximum": 72
            }
          },
          "additionalProperties": false
        },
        "position": {
          "type": "object",
          "description": "Position configuration",
          "properties": {
            "x": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 1000
                },
                {
                  "type": "string",
                  "enum": ["center", "left", "right"]
                }
              ],
              "description": "X position in pixels or alignment"
            },
            "y": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 1000
                },
                {
                  "type": "string",
                  "enum": ["center", "top", "bottom"]
                }
              ],
              "description": "Y position in pixels or alignment"
            }
          },
          "additionalProperties": false
        },
        "format": {
          "type": "string",
          "description": "Format string for time/date display (e.g., '24h', '12h', or strftime format)",
          "maxLength": 100
        },
        "unit": {
          "type": "string",
          "description": "Unit for temperature/measurement display",
          "enum": ["celsius", "fahrenheit"]
        },
        "show_icon": {
          "type": "boolean",
          "description": "Whether to show an icon with the display"
        },
        "scroll": {
          "type": "boolean",
          "description": "Whether to enable scrolling for long text"
        },
        "id": {
          "type": "string",
          "description": "Internal frame identifier"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
