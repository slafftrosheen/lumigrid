{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LumiGrid Sensor Data Schema",
  "description": "Schema for sensor data updates",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "readings": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "humidity": {
          "type": "number"
        },
        "motion": {
          "type": "boolean"
        },
        "light": {
          "type": "number"
        }
      },
      "minProperties": 1
    },
    "timestamp": {
      "type": "integer"
    }
  },
  "required": ["node_id", "readings"]
}
