  #       preset_name: "Current Time"
  #       trigger_type: "time_of_day"
  #       time_of_day: "09:00:00"
  #       days_of_week: [0, 1, 2, 3, 4]  # Weekdays only
  #       start_time: "08:00:00"  # Active from 8 AM
  #       end_time: "17:00:00"    # Until 5 PM
  #       duration: 0
