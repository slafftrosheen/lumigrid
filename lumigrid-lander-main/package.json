{
  "name": "lumigrid-sveltekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:local-windows": "node scripts/baseline-gate-patch.mjs && vite build",
    "preview": "vite preview",
    "start": "node build",
    "lint:copy": "node scripts/lint-copy.mjs",
    "check": "svelte-kit sync && npm run lint:copy && npm run test:marketing && npm run test:continuity && svelte-check --fail-on-warnings",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run --passWithNoTests",
    "test:embedded": "node --test embedded/dashboard.test.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "build:embedded": "node scripts/build-embedded.mjs",
    "docs:sync": "python ../scripts/sync_documentation.py",
    "docs:check": "python ../scripts/sync_documentation.py --check",
    "predev": "npm run docs:sync",
    "prebuild": "npm run docs:sync",
    "precheck": "npm run docs:check",
    "test:marketing": "node scripts/test-public-copy.mjs",
    "test:continuity": "node scripts/test-continuity.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@sveltejs/adapter-vercel": "^6.3.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.1.0",
    "marked": "^17.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^2.1.5"
  }
}
